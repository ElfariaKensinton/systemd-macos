#compdef systemctl

_systemd_macos_units() {
  local -a units
  local dir file

  if (( $+commands[systemctl] )); then
    units=( ${(f)"$(command systemctl list-unit-files --no-legend 2>/dev/null | awk 'NF {print $1}' )"} )
  fi

  if (( ${#units} == 0 )); then
    for dir in /etc/systemd/system /usr/local/lib/systemd/system; do
      for file in "$dir"/*.service(N); do
        [[ -e "$file" ]] || continue
        units+=("${file:t}")
      done
    done
  fi

  (( ${#units} )) || return 1
  compadd -a units
}

_systemctl() {
  local -a commands options
  local command

  commands=(
    start stop restart reload status enable disable is-active is-enabled
    daemon-reload list-units list-unit-files cat show
  )
  options=(
    --now --quiet -q --no-legend --no-pager --system --user --plain
    --version --help -h
  )

  if (( CURRENT == 2 )); then
    compadd -- $commands $options
    return 0
  fi

  command="${words[2]}"
  case "$command" in
    start|stop|restart|reload|status|enable|disable|is-active|is-enabled|cat|show)
      _systemd_macos_units
      return 0
      ;;
  esac

  case "$PREFIX" in
    -*)
      compadd -- $options
      ;;
  esac
}

# Make the file usable when sourced directly, as well as when loaded by compinit.
if (( $+functions[compdef] )); then
  compdef _systemctl systemctl
fi

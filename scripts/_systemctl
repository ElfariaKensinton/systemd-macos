#compdef systemctl

_systemd_macos_units() {
  local -a units
  local dir file

  if (( $+commands[systemctl] )); then
    units=( ${(f)"$(command systemctl list-unit-files --no-legend 2>/dev/null | awk 'NF {print $1}' )"} )
  fi

  if (( ${#units} == 0 )); then
    for dir in /etc/systemd/system /usr/local/lib/systemd/system; do
      for file in "$dir"/*.service(N); do
        [[ -e "$file" ]] || continue
        units+=("${file:t}")
      done
    done
  fi

  (( ${#units} )) || return 1
  _describe 'unit' units
}

_systemctl() {
  local -a systemctl_commands opts
  systemctl_commands=(
    'start:Start units'
    'stop:Stop units'
    'restart:Restart units'
    'reload:Reload units'
    'status:Show runtime status'
    'enable:Enable units'
    'disable:Disable units'
    'is-active:Check whether units are active'
    'is-enabled:Check whether units are enabled'
    'daemon-reload:Reload unit files'
    'list-units:List loaded units'
    'list-unit-files:List installed unit files'
    'cat:Show unit file contents'
    'show:Show machine-readable properties'
  )

  opts=(
    '--now[Enable/disable and immediately start/stop]'
    '(-q --quiet)'{-q,--quiet}'[Suppress successful output]'
    '--no-legend[Omit headers]'
    '--no-pager[Disable the pager]'
    '--system[Use system scope]'
    '--user[Use user scope]'
    '--plain[Accepted for systemctl compatibility]'
    '(-h --help)'{-h,--help}'[Show help]'
    '--version[Show version]'
  )

  _arguments -s -C $opts \
    '1:command:->command' \
    '*::unit:_systemd_macos_units'

  case $state in
    command)
      _describe 'command' systemctl_commands
      ;;
  esac
}
